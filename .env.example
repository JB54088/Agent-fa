# Canonical database: PostgreSQL + Drizzle ORM. The Worker runtime uses the
# Neon-compatible HTTP driver; do not leave this unset in production.
DATABASE_URL=
DB_PROVIDER=postgresql

# Auth (use NEXTAUTH_* names for the production contract)
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Optional notification adapters (reserved for phase 3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMS_PROVIDER_API_KEY=

# App configuration
NEXT_PUBLIC_SITE_NAME=校招雷达
CRON_SECRET=replace-with-a-long-random-string
INITIAL_SYNC_SECRET=replace-with-a-separate-long-random-string
