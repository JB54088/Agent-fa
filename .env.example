DATABASE_URL=
MEMBERSHIP_ENFORCEMENT_ENABLED=false
# Generate a 32-byte key (base64 or 64-character hex) and keep it outside Git.
ACTIVATION_CODE_ENCRYPTION_KEY=
# Optional public customer-service WeChat ID; QR image path may be public/customer-service-wechat.png.
CUSTOMER_SERVICE_WECHAT=
# Optional local-development PostgreSQL bridge; never set this in production.
NEON_LOCAL_ENDPOINT=
AUTH_SESSION_SECRET=
PASSWORD_RESET_ENABLED=false
DB_PROVIDER=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
JWT_SECRET=

# Set exactly three administrator phone numbers in the production environment.
# All other registered accounts remain customer accounts.
ADMIN_PHONE_1=
ADMIN_PHONE_2=
ADMIN_PHONE_3=
# One-time initializer only; remove this production variable after npm run init-admin.
ADMIN_INITIAL_PASSWORD_1=
ADMIN_NAME_1=校招雷达管理员

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Alibaba Cloud SMS credentials and approved template configuration.
# Set these only in the server environment; never commit real values.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_PARAM_NAME=
# Restrict the temporary SMS test endpoint to this Aliyun-console-authorized number.
ALIYUN_SMS_TEST_PHONE=
# Unauthenticated test requests are accepted only outside production.
SMS_TEST_MODE=false

NEXT_PUBLIC_SITE_NAME=
CRON_SECRET=
INITIAL_SYNC_SECRET=
