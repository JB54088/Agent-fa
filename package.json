{
  "name": "school-recruitment-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cd frontend && vinext dev",
    "dev:local": "node --env-file=.env.local backend/dev-tools/start-local.mjs",
    "db:local:proxy": "node --env-file=.env.local backend/dev-tools/neon-local-proxy.mjs",
    "build": "cd frontend && vinext build",
    "start": "cd frontend && vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/collection.test.mjs tests/major-directory.test.mjs tests/reminders.test.mjs tests/national-directory.test.mjs tests/excel-import.test.mjs tests/auth-unit.test.mjs tests/membership.test.mjs tests/password-reset.test.mjs tests/review-errors.test.mjs tests/source-pool.test.mjs",
    "lint": "cd frontend && eslint .",
    "db:generate": "cd backend && drizzle-kit generate",
    "db:migrate": "cd backend && drizzle-kit migrate",
    "db:import-current-batch": "node --experimental-strip-types backend/scripts/import-current-batch.ts",
    "source-pool:inspect": "node --experimental-strip-types backend/scripts/inspect-source-pool.ts",
    "source-pool:migrate": "node --experimental-strip-types backend/scripts/migrate-source-pool.ts",
    "source-pool:import": "node --experimental-strip-types backend/scripts/import-source-pool.ts",
    "source-pool:seed-queries": "node --experimental-strip-types backend/scripts/seed-discovery-queries.ts",
    "source-pool:export": "node --experimental-strip-types backend/scripts/export-source-pool.ts",
    "source-pool:query": "node --experimental-strip-types backend/scripts/query-source-pool.ts",
    "source-discovery:daily": "node --experimental-strip-types backend/scripts/run-source-discovery-daily.ts",
    "db:seed": "node --experimental-strip-types backend/db/seed.ts",
    "create-admin": "node --experimental-strip-types backend/scripts/create_admin.ts",
    "init-admin": "node --experimental-strip-types backend/scripts/init-admin.ts",
    "reset-password": "node --experimental-strip-types backend/scripts/reset_password.ts",
    "sources:export": "node --experimental-strip-types backend/scripts/generate-source-docs.mjs",
    "validate:major-directory": "node backend/scripts/validate-major-directory.mjs"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "^4.6.0",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pg": "^8.23.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260515.1": true
  }
}
